# Server Configuration
PORT=5000
NODE_ENV=development
API_BASE_URL=http://localhost:5000

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/lead_management

# Redis Connection (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & Encryption (32-byte hex or string)
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_SECRET=super_secret_jwt_key_lead_pipeline_change_in_prod
JWT_EXPIRES_IN=7d

# Facebook App Credentials
FB_APP_ID=your_facebook_app_id
FB_APP_SECRET=your_facebook_app_secret
FB_VERIFY_TOKEN=your_secure_custom_webhook_verify_token
FB_GRAPH_API_VERSION=v21.0

# External CRM Default Configuration (Optional Fallbacks)
DEFAULT_CRM_ENDPOINT=https://api.yourcrm.com/leads
DEFAULT_CRM_AUTH_TOKEN=
